# Required in production for correct absolute URLs (sitemap, robots.txt, Open Graph).
# Example: https://your-family-hotel.example.com
NEXT_PUBLIC_SITE_URL=

# Resend: contact form emails. Get API key at https://resend.com/api-keys
RESEND_API_KEY=
# Recipient for Get in Touch form submissions
USER_EMAIL=
# Optional: verified sender (default: onboarding@resend.dev for testing)
# RESEND_FROM_EMAIL=Manna Family Hotel <onboarding@resend.dev>
