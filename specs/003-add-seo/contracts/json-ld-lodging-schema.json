{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "json-ld-lodging-schema",
  "title": "LodgingBusiness JSON-LD",
  "description": "Schema for the JSON-LD script injected into the page. Must validate against schema.org LodgingBusiness. Used for FR-006 and local/business search.",
  "type": "object",
  "required": ["@context", "@type", "name", "description", "url", "address"],
  "properties": {
    "@context": { "const": "https://schema.org" },
    "@type": { "const": "LodgingBusiness" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "image": { "type": "string", "format": "uri" },
    "telephone": { "type": "string" },
    "priceRange": { "type": "string" },
    "address": {
      "type": "object",
      "required": ["addressCountry", "addressRegion", "addressLocality"],
      "properties": {
        "@type": { "const": "PostalAddress" },
        "addressCountry": { "type": "string" },
        "addressRegion": { "type": "string" },
        "addressLocality": { "type": "string" },
        "streetAddress": { "type": "string" },
        "postalCode": { "type": "string" }
      }
    },
    "amenityFeature": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@type": { "const": "LocationFeatureSpecification" },
          "name": { "type": "string" },
          "value": { "type": "boolean" }
        }
      }
    },
    "availableLanguage": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checkinTime": { "type": "string" },
    "checkoutTime": { "type": "string" },
    "inLanguage": { "type": "string", "description": "Optional when emitting per-locale JSON-LD" }
  }
}
